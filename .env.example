# Copy to .env and fill in what you have. Every key is optional: Trivet runs with
# whichever engines it can authenticate, and tells you when none can.

# --- access ---------------------------------------------------------------
# Leave both unset for a localhost-only instance. Set them before exposing it.
# TRIVET_USER=admin
# TRIVET_PASS=change-me

# Signs session cookies. Leave it blank and one is generated and kept at
# ~/.config/trivet/session-secret (0600) on first run, so sessions survive restarts.
# Set it explicitly on a container so a rebuild does not drop every login:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TRIVET_SESSION_SECRET=
# TRIVET_SESSION_DAYS=90

# Encrypts API keys entered at /settings/keys. Without it the UI refuses to
# store keys and only environment variables work.
TRIVET_SECRET_KEY=

# --- engines (add the ones you have) --------------------------------------
KEENABLE_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
LINKUP_API_KEY=
FIRECRAWL_API_KEY=
VALYU_API_KEY=
PARALLEL_API_KEY=

# --- optional -------------------------------------------------------------
# TRIVET_DB=~/.cache/trivet/cache.db
# TRIVET_CACHE_TTL=900
# TRIVET_ADGUARD_URL=http://127.0.0.1:3001
# TRIVET_ADGUARD_PASSWORD_FILE=~/.config/trivet/adguard-password
# TRIVET_INFISICAL_PROJECT=
# TRIVET_INFISICAL_TOKEN_FILE=~/.cache/trivet/infisical-token
